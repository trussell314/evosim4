{
  "name": "evosim4",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "bench": "vitest run --config vitest.bench.config.ts",
    "lint:cycles": "madge --circular --extensions ts src"
  },
  "devDependencies": {
    "madge": "^8.0.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^4.1.5"
  }
}
