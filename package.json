{
  "name": "evosim4",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "bench": "vitest run --config vitest.bench.config.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:cycles": "eslint \"src/**/*.ts\"",
    "lint:cycles:madge": "madge --circular --extensions ts src"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "madge": "^8.0.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.60.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.5"
  }
}
